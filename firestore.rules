rules_version = '2';

// Originally verified against a real local Firestore emulator (not just
// read for plausibility) via @firebase/rules-unit-testing: confirmed a
// signed-in user can read/write their own progress/{uid} and
// leaderboard/{uid} documents, is BLOCKED from writing another user's
// document in either collection, an unauthenticated client is blocked
// from progress/{uid} on every document, and a blocked write never
// corrupts the target document. leaderboard/{uid} reads were later
// widened from "any signed-in user" to fully public (`allow read: if
// true`) -- a leaderboard is meant to be visible to a browsing,
// not-yet-signed-in visitor too, and every field ever written there is
// deliberately public-safe (see the collection's own comment below). A
// user still cannot read another user's private progress/{uid} either
// way, and write access to both collections is unchanged. That
// verification tooling (firebase-tools + @firebase/rules-unit-testing)
// was intentionally not left as a permanent devDependency -- to
// re-verify after a future rules change: `npm install --save-dev
// firebase-tools @firebase/rules-unit-testing`,
// run `npx firebase emulators:start --only firestore --project demo-neuralmastery`
// (add `CHOKIDAR_USEPOLLING=true` if it fails with an inotify ENOSPC error
// on a busy shared machine), then drive it with initializeTestEnvironment
// + assertSucceeds/assertFails against the cases named above, then
// uninstall both packages again.
service cloud.firestore {
  match /databases/{database}/documents {
    // Progress-sync data (also holds the gamification event log as a
    // sibling field -- see GamificationContext): exactly one document per
    // signed-in user, keyed by their own Firebase Auth UID. A user may
    // read or write ONLY their own document -- never another user's,
    // signed in or not. Everything else in this database has no rule
    // below, and Firestore denies by default, so no other collection is
    // reachable at all.
    match /progress/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Public leaderboard snapshot: deliberately DIFFERENT read rule from
    // progress/{uid} above -- truly public (any client, signed in or not,
    // may read ANY entry here -- a ranking is meant to be visible to a
    // browsing, not-yet-signed-in visitor too, and a ranking query needs
    // to see every user's points regardless), but a user may still only
    // WRITE their own entry, exactly like progress/{uid}. This is the
    // real reason a separate collection exists at all: a leaderboard
    // genuinely cannot be computed against progress/{uid}'s rules
    // without weakening that document's real privacy guarantee. Every
    // field ever written here (displayName, allTimePoints, weeklyPoints,
    // weekStart, updatedAt -- see leaderboardFields in
    // GamificationContext.tsx) is intentionally public-safe: no email,
    // no uid-linked PII beyond a user-chosen display name.
    match /leaderboard/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Admins: the site owner, by verified email, plus anyone with an
    // admins/{uid} document. Those documents are added by hand in the
    // Firebase console: no client can write them. email_verified matters:
    // the site also allows email/password sign-up, and an unverified
    // account could claim any address.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && (request.auth.token.email == 'ravivarmapatturi@gmail.com'
            || exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    // An admin may read their own admins/{uid} entry (the editor uses it
    // to decide whether to show itself). Nobody may write it from a client.
    match /admins/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
    }

    // Blog posts written in the site's editor (src/lib/blogStore.ts).
    // Anyone may read a published post. Drafts, and every write, are
    // admin-only. Writes must keep the document's slug equal to its id,
    // use a known status, and stay a sensible size.
    match /blogPosts/{slug} {
      allow read: if resource.data.status == 'published' || isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.slug == slug
        && request.resource.data.status in ['draft', 'published']
        && request.resource.data.title is string && request.resource.data.title.size() > 0
        && request.resource.data.body is string && request.resource.data.body.size() < 200000;
      allow delete: if isAdmin();
    }
  }
}
