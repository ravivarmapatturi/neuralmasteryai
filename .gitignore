# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Scratch directory used by scripts/prerender-for-pagefind.mjs -- rendered
# HTML snapshots used only to generate the Pagefind index, never deployed.
.pagefind-prerender

# Playwright test artifacts
test-results
playwright-report
blob-report

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store

# Generated output from .verify-scripts/verify.cjs (screenshots, results.json) --
# the script itself is kept for re-running future verification passes.
.verify-scripts/*.png
.verify-scripts/results.json
.verify-scripts/mobilenav-results.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

ml-drift-monitor

/screenshots/
!docs/screenshots/
docs/screenshots/ml-atlas/
!docs/screenshots/**interview-room/

# Agent scratch output, never deployed
scratch/
helpers/agy-*.md

# Python bytecode cache
__pycache__/
*.py[cod]
*$py.class

# Large WASM and ML model data bundles (run node scripts/download-sherpa-model.mjs)
public/sherpa-onnx/*.data
public/sherpa-onnx/*.wasm

# Answer-length speech test audio lives on the speech-eval branch only
scripts/speech-accuracy/audio-v2/
