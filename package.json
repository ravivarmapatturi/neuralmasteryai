{
  "name": "platform-vite",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "predev": "node scripts/generate-page-meta.mjs && node scripts/generate-last-updated.mjs && npm run generate:interviews",
    "typecheck": "tsc -b",
    "build": "tsc -b && NODE_OPTIONS=--max-old-space-size=8192 vite build && node scripts/copy-404.mjs && node scripts/generate-sitemap.mjs",
    "prebuild": "node scripts/generate-page-meta.mjs && node scripts/generate-last-updated.mjs && npm run generate:interviews",
    "check:tracker": "node scripts/check-agent-tracker.mjs",
    "pagefind": "node scripts/prerender-for-pagefind.mjs && pagefind --site .pagefind-prerender --output-path dist/pagefind",
    "check:links": "node scripts/check-internal-links.mjs && node scripts/check-anchor-links.mjs",
    "check:anchors": "node scripts/check-anchor-links.mjs",
    "serve:dist": "node scripts/static-server.cjs",
    "test:smoke": "playwright test",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:unit:coverage": "vitest run --coverage",
    "lint": "oxlint",
    "preview": "vite preview",
    "generate:interviews": "node scripts/interview/export-interview-catalog.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.4",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@mdx-js/react": "^3.1.1",
    "@mdx-js/rollup": "^3.1.1",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@xyflow/react": "^12.11.3",
    "codemirror": "^6.0.2",
    "d3": "^7.9.0",
    "firebase": "^12.18.0",
    "framer-motion": "^13.1.0",
    "hast-util-to-jsx-runtime": "^2.3.6",
    "katex": "^0.18.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "rehype-katex": "^7.0.1",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-mdx-frontmatter": "^5.2.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "roughjs": "^4.6.6",
    "shiki": "^4.4.3",
    "three": "^0.185.1",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/d3": "^7.4.3",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^4.1.11",
    "@webgpu/types": "^0.1.72",
    "gray-matter": "^4.0.3",
    "js-yaml": "^5.3.0",
    "jsdom": "^30.0.1",
    "oxlint": "^1.75.0",
    "pagefind": "^1.5.2",
    "playwright": "^1.62.1",
    "remark-mdx": "^3.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^6.4.3",
    "vitest": "^4.1.11"
  }
}
